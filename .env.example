# --- Groq (geração via LLM real) ---
# Crie sua API key gratuita em https://console.groq.com/keys
GROQ_API_KEY=sua_api_key_aqui
GROQ_MODEL=openai/gpt-oss-120b
# Limite de tokens por minuto do seu plano Groq e teto da resposta. A Groq conta
# prompt + max_tokens contra o TPM; o gerador corta o contexto para caber nele.
GROQ_TPM_LIMIT=8000
GROQ_MAX_OUTPUT_TOKENS=600

# --- Banco vetorial (RAG: documentos, chunks, embeddings) ---
RAGDB_URL=postgresql://postgres:postgres@localhost:5433/ragdb

# --- Banco de usuários (contas + histórico de conversas) ---
USERSDB_URL=postgresql://postgres:postgres@localhost:5434/usersdb

# --- Modelo de embedding local (roda na sua máquina, sem custo/API) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
