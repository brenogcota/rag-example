GROQ_API_KEY=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
GROQ_MODEL=openai/gpt-oss-120b

# --- Banco vetorial (RAG: documentos, chunks, embeddings) ---
